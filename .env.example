# Vibe Coding Guard — optional runtime environment overrides
#
# This project stores no secrets. These variables only tweak runtime behavior
# and normally come from config.json / .claude/vibe-coding-guard.json. Set them
# in your shell to override per-invocation. Copy to .env and adjust as needed.

# Install location of the guard's shared library (set by install.sh).
# VCG_HOME=~/.vibe-coding-guard

# Enable verbose debug logging from the hooks (0 = off, 1 = on).
# VCG_DEBUG=0

# Skip the OSV.dev network lookup during dependency scanning (offline/CI use).
# VCG_SKIP_OSV=false
